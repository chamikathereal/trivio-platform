{
  "name": "@trivio.ink/node",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side Node.js SDK foundation for Trivio Payment Settlement Intelligence",
  "homepage": "https://trivio.ink",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@trivio.ink/core": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
