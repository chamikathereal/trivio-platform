# Trivio Cloud API Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String
# For local Docker setup: postgresql://postgres:postgres@localhost:5432/trivio_dev?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trivio_dev?schema=public"

# Test Database Connection String
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/trivio_test?schema=public"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
